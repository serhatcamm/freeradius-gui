#!/usr/bin/env python3
"""frw-write: the only privileged helper the web panel needs.

Invoked as::

    frw-write <absolute-path> [octal-mode]

with the new file content on stdin. The path is resolved (following
symlinks) and checked against a fixed allow-list; anything else is refused.

Design constraints:

* No arguments beyond the target and an optional mode.
* Content comes from stdin, never from argv (avoids ARG_MAX and shell
  quoting entirely - there is no shell involved).
* The write is atomic: a temp file in the same directory, fsync, rename,
  then fsync the directory.
* Ownership and mode of the existing file are preserved.

This helper must be owned by root and mode 0755 (no setuid bit needed: the
sudoers rule grants root for exactly this one program).
"""
from __future__ import annotations

import os
import shutil
import sys
import tempfile

#: Files the panel is allowed to rewrite. Compared *after* symlink
#: resolution, so /etc/freeradius/3.0/users maps to its real target.
ALLOWED = (
    "/etc/freeradius/3.0/mods-config/files/authorize",
    "/etc/freeradius/3.0/clients.conf",
    "/etc/freeradius/3.0/sites-available/default",
    "/etc/freeradius/3.0/mods-available/linelog",
    "/etc/freeradius/3.0/mods-config/files/groups",
)

MAX_BYTES = 8 * 1024 * 1024


def fail(message: str) -> "int":
    print(f"frw-write: {message}", file=sys.stderr)
    return 1


def main(argv: list[str]) -> int:
    # argv here is already stripped of the program name.
    if os.geteuid() != 0:
        return fail("must run as root")

    if argv and argv[0] in ("-h", "--help"):
        print(
            "usage: frw-write <absolute-path> [octal-mode]\n"
            "       reads the new file content from stdin\n"
            "\n"
            "Allowed paths:\n"
            + "".join(f"  {p}\n" for p in ALLOWED)
        )
        return 0

    if len(argv) not in (1, 2):
        return fail("usage: frw-write <absolute-path> [octal-mode]")

    raw_path = argv[0]
    if not raw_path.startswith("/"):
        return fail("path must be absolute")

    # Reject traversal attempts before resolving.
    if ".." in raw_path.split("/"):
        return fail("path must not contain '..'")

    try:
        real = os.path.realpath(raw_path)
    except OSError as exc:
        return fail(f"cannot resolve path: {exc}")

    if real not in ALLOWED:
        return fail(f"path is not in the allow-list: {real}")

    mode: int | None = None
    if len(argv) == 2 and argv[1] != "-":
        try:
            mode = int(argv[1], 8)
        except ValueError:
            return fail("mode must be octal")
        # Only the rwx bits are ever legitimate here; refusing setuid/setgid/
        # sticky prevents the helper from being used to create a
        # privilege-escalating file.
        if mode & ~0o777:
            return fail("mode may only contain rwx permission bits")

    data = sys.stdin.buffer.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        return fail("content too large")

    # Preserve the existing owner/mode unless told otherwise.
    try:
        st = os.stat(real)
        file_mode = mode if mode is not None else (st.st_mode & 0o7777)
        uid, gid = st.st_uid, st.st_gid
    except FileNotFoundError:
        file_mode = mode if mode is not None else 0o640
        uid = gid = -1

    directory = os.path.dirname(real)
    if not os.path.isdir(directory):
        return fail(f"directory does not exist: {directory}")

    tmp_fd, tmp_path = tempfile.mkstemp(
        dir=directory, prefix=".frw-write.", suffix=".tmp"
    )
    try:
        with os.fdopen(tmp_fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())

        os.chmod(tmp_path, file_mode)
        if uid != -1:
            try:
                os.chown(tmp_path, uid, gid)
            except PermissionError:
                pass

        os.replace(tmp_path, real)

        # Make the rename itself durable.
        dir_fd = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except Exception as exc:  # noqa: BLE001
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        return fail(f"write failed: {exc}")

    # A backup of the previous content is the caller's job (see
    # services/config_tx.py); this helper only performs the atomic replace.
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))