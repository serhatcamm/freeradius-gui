# Normalise line endings. The deployment target is Linux, so shell scripts and
# unit files must stay LF in the repository; CRLF makes bash fail with
# "bad interpreter: /bin/bash^M".
* text=auto eol=lf

*.sh   text eol=lf
frw-write text eol=lf
*.service text eol=lf
*.conf  text eol=lf
*.orig  text eol=lf

# Windows-only tooling stays native.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets must never be line-ending translated.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary